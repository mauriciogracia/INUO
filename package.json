{
  "name": "inuo-cli",
  "version": "00.03.70",
  "description": "Interactive shell CLI for the iNoU Platform matching protocol and specification lifecycle",
  "main": "dist/models/index.js",
  "bin": {
    "inuo": "./bin/inuo.js"
  },
  "scripts": {
    "build": "tsc && tsc --project tsconfig.browser.json",
    "dev": "tsc && node dist/scripts/devWatcher.js",
    "dev:web": "npm run build && node dist/scripts/devWatcher.js web 3000",
    "web": "npm run build && node bin/inuo.js web",
    "serve": "tsc && node dist/scripts/devWatcher.js",
    "improvements:sync": "node scripts/sync-improvements.js",
    "pretest": "npm run build",
    "cli": "npm run build && node bin/inuo.js",
    "init": "npm run build && node bin/inuo.js init",
    "status": "npm run build && node bin/inuo.js status",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "inuo",
    "matching-protocol",
    "interaction-engine",
    "specification-lifecycle",
    "self-orchestrating"
  ],
  "author": "INUO Development Team",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "*",
    "blessed": "^0.1.81",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.27",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3"
  }
}
